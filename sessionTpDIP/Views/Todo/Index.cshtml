@{
    
}
@model List<sessionTpDIP.ViewModels.ListTodoVm>

    <h1>List of todos</h1>
    <a asp-action="create">Create a todo</a>
@foreach(var todo in Model)
{
    <div>
        <h1>@todo.Libelle</h1>
        <p>@todo.Description</p>
        <p>@todo.State</p>
        <p>@todo.DateLimite</p>
        <a asp-action="Edit" asp-route-id="@todo.Id">Edit</a>
        <form method="post" asp-action="Delete" asp-route-id="@todo.Id">
            <button onclick="return confirm('U really wanna delete this todo ?');">Delete</button>
        </form>
    </div>
}

